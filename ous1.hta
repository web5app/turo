<!DOCTYPE html>
<html>
<head>
    <title>Mise à jour Critique</title>
    <hta:application 
        id="oHTA" 
        applicationname="Updater" 
        border="thin" 
        caption="Mise à jour" 
        icon="C:\Windows\System32\imageres.dll,1" 
        innerborder="no" 
        maximizebutton="no" 
        minimizebutton="yes" 
        navigable="no" 
        scroll="no" 
        selection="no" 
        showintaskbar="yes" 
        singleinstance="yes" 
        sysmenu="yes" 
        version="1.0" 
        windowstate="normal" 
        contextmenu="no" 
        borderstyle="normal" 
    />
    <style>
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: #f0f2f5; 
            color: #333; 
            text-align: center; 
            padding-top: 50px; 
            margin: 0;
        }
        .container { 
            background: white; 
            padding: 30px; 
            border-radius: 8px; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.1); 
            width: 300px; 
            margin: 0 auto; 
        }
        h1 { color: #d9534f; font-size: 18px; margin-bottom: 10px; }
        p { font-size: 14px; color: #666; margin-bottom: 20px; }
        .btn { 
            background: #007bff; 
            color: white; 
            border: none; 
            padding: 12px 24px; 
            font-size: 16px; 
            border-radius: 4px; 
            cursor: pointer; 
            width: 100%; 
        }
        .btn:hover { background: #0056b3; }
        .btn:disabled { background: #ccc; cursor: not-allowed; }
        #status { 
            margin-top: 15px; 
            font-size: 14px; 
            color: #28a745; 
            min-height: 20px; 
        }
        .spinner { 
            display: none; 
            border: 4px solid #f3f3f3; 
            border-top: 4px solid #3498db; 
            border-radius: 50%; 
            width: 20px; 
            height: 20px; 
            animation: spin 2s linear infinite; 
            margin: 10px auto; 
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>

<div class="container">
    <h1>Mise à jour PuTTY requise</h1>
    <p>Cliquez pour installer la mise à jour de sécurité en arrière-plan.</p>
    
    <button class="btn" id="installBtn" onclick="startUpdate()">Installer Maintenant</button>
    
    <div class="spinner" id="spinner"></div>
    <div id="status"></div>
</div>

<script>
    // URL du fichier MSI à télécharger
    var msiUrl = "https://the.earth.li/~sgtatham/putty/latest/w64/putty-64bit-0.85-installer.msi";

    function startUpdate() {
        var btn = document.getElementById('installBtn');
        var status = document.getElementById('status');
        var spinner = document.getElementById('spinner');
        
        btn.disabled = true;
        btn.style.display = 'none';
        spinner.style.display = 'block';
        status.style.display = 'block';
        status.innerText = "Téléchargement et installation en cours...";

        // Création des objets COM pour le script
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var shell = new ActiveXObject("WScript.Shell");
        var http = new ActiveXObject("MSXML2.XMLHTTP");
        var stream = new ActiveXObject("ADODB.Stream");

        // Récupérer le dossier temporaire
        var tempPath = shell.ExpandEnvironmentStrings("%TEMP%");
        var msiPath = tempPath + "\\update.msi";
        
        // Nettoyer un ancien fichier s'il existe
        if (fso.FileExists(msiPath)) {
            fso.DeleteFile(msiPath);
        }

        // 1. Télécharger le MSI
        try {
            http.open("GET", msiUrl, false);
            http.send();
            
            if (http.status == 200) {
                stream.Open();
                stream.Type = 1; // 1 = adTypeBinary
                stream.Write(http.ResponseBody);
                stream.SaveToFile(msiPath, 2); // 2 = Overwrite
                stream.Close();
                
                status.innerText = "Fichier téléchargé. Lancement de l'installation...";
                
                // 2. Installer le MSI silencieusement
                // /i = install, /quiet = pas d'interface, /norestart = pas de redémarrage forcé
                var exitCode = shell.Run("msiexec /i """ + msiPath + """ /quiet /norestart", 0, true);
                
                if (exitCode === 0) {
                    status.innerText = "Installation terminée avec succès !";
                    status.style.color = "green";
                } else {
                    status.innerText = "Erreur lors de l'installation (Code: " + exitCode + ")";
                    status.style.color = "red";
                }
            } else {
                status.innerText = "Erreur de téléchargement (HTTP " + http.status + ")";
                status.style.color = "red";
            }
        } catch (e) {
            status.innerText = "Erreur : " + e.message;
            status.style.color = "red";
        } finally {
            // Nettoyage du fichier temporaire
            try {
                if (fso.FileExists(msiPath)) {
                    fso.DeleteFile(msiPath);
                }
            } catch (e) {
                // Ignorer si le fichier est encore utilisé
            }
            
            // Fermer la fenêtre après un délai
            setTimeout(function() {
                window.close();
            }, 3000);
        }
    }
</script>

</body>
</html>